# Copy this file to .env and replace the placeholders.
# Never commit .env or paste a real bot token into a public repository.

TELEGRAM_BOT_TOKEN="REPLACE_WITH_YOUR_ROTATED_BOT_TOKEN"
TELEGRAM_CHAT_ID="REPLACE_WITH_YOUR_CHAT_ID"

# Percentages: warning must be lower than critical.
WARNING_THRESHOLD=70
CRITICAL_THRESHOLD=90

# Optional. Defaults to system_monitor.log in this repository directory.
# LOG_FILE="/var/log/linux-system-monitor/system_monitor.log"
